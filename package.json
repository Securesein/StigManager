{
  "name": "stig-manager",
  "version": "1.0.0",
  "description": "Desktop app voor het beheren van DISA STIGs over versies",
  "main": "main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "rebuild": "npx @electron/rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "exceljs": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "papaparse": "^5.4.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  },
  "license": "MIT"
}
